POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=replace_with_a_local_password

# Use a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# Browser-visible URLs. VITE_API_URL is baked into the frontend at build time.
CLIENT_URL=http://localhost:8080
VITE_API_URL=http://localhost:5000

API_PORT=5000
WEB_PORT=8080
